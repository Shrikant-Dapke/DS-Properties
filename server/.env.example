PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/ds_properties?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Developer seed (run: npm run seed:developer)
DEV_USERNAME=developer
DEV_PASSWORD=change_me_in_production
DEV_EMAIL=dev@dsproperties.local
DEV_NAME=Developer

# Partner login linking (optional, run: npm run seed:partner-users with CREATE_PARTNER_USERS=true)
# When true, each Partner business record gets a linked User(role:'partner').
CREATE_PARTNER_USERS=false
PARTNER_DEFAULT_PASSWORD=change_me_in_production
