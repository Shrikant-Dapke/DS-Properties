# DS Properties V4 — Backend environment
# Copy to .env and adjust.

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL
# Local development uses the individual fields below. Production on Vercel +
# Supabase uses a single connection string instead (Supabase dashboard >
# Project Settings > Database > Connection string, pooled port 6543 for
# serverless). When DATABASE_URL is set, PGHOST/PGPORT/PGUSER/PGPASSWORD/
# PGDATABASE are optional and ignored for connections.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# PGSSL is ON by default when DATABASE_URL is set (Supabase requires SSL).
# PGPOOL_MAX caps connections per serverless instance (default 5 in
# production, 20 otherwise).
PGHOST=localhost
PGPORT=5432
PGUSER=dsp_v4
PGPASSWORD=dsp_v4_password
PGDATABASE=ds_properties_v4

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Initial admin seed password. Set a strong unique value BEFORE the first
# `npm run seed` on any real environment. When unset, the seed falls back to
# a local-dev default (see seeds/002_seed_admin_user.js) — never rely on the
# fallback outside local development.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Owner-only developer account. The developer role can NEVER be granted
# through the application API (validators and services reject it for every
# caller). Provision it exactly one of these owner-shell ways:
#   1. Fresh database: set these BEFORE `npm run seed`
#      (seeds/004_seed_developer_user.js creates it once, then skips).
#   2. Existing database: DEVELOPER_USERNAME + DEVELOPER_PASSWORD
#      `npm run provision-developer` (add --reset to rotate).
# There is intentionally NO dev fallback: without these, no developer exists.
SEED_DEVELOPER_USERNAME=owner
SEED_DEVELOPER_PASSWORD=replace-with-a-strong-owner-password
# DEVELOPER_USERNAME / DEVELOPER_PASSWORD (provision-developer CLI only)

# Optional test/smoke overrides (all fall back to the seed default above):
# TEST_ADMIN_USERNAME / TEST_ADMIN_PASSWORD (backend Jest suite)
# SMOKE_ADMIN_USERNAME / SMOKE_ADMIN_PASSWORD (backend smoke script)

# Security
CORS_ORIGIN=http://localhost:5173
# Production: comma-separated frontend origin(s), e.g.
# CORS_ORIGIN=https://ds-properties.vercel.app
# Vercel runs behind a proxy, so production also needs TRUST_PROXY=true.
TRUST_PROXY=false

# Financial
OPENING_BALANCE=0